{
  "name": "x-tweet-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HTTP-only X (Twitter) scraper Actor with a tamper-resistant free-tier cap",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run start:dev",
    "start:dev": "tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "gauntlet": "npm run typecheck && npm run lint && npm run test:coverage && npm run test:mutation"
  },
  "dependencies": {
    "apify": "^3.4.2",
    "apify-client": "^2.12.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@stryker-mutator/core": "^9.0.1",
    "@stryker-mutator/typescript-checker": "^9.0.1",
    "@stryker-mutator/vitest-runner": "^9.0.1",
    "@types/node": "^22.17.0",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.34.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}
